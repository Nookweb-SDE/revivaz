# IA (acolhimento + nota-clínica) = Claude CLI da ASSINATURA via ponte HTTP local.
# SEM token de LLM: o app só precisa da URL da ponte + o secret dela.
# Na VPS isso vem por Docker secret (*_FILE); local, aponte pra uma ponte de dev.
CLAUDE_BRIDGE_URL=      # ex: http://host.docker.internal:8787/ask
CLAUDE_BRIDGE_SECRET=   # mesmo BRIDGE_SECRET da ponte (deploy/claude-vps/bridge.mjs)

# Supabase — público (usado no frontend via VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-side only (NUNCA expor no frontend)
# Necessário para o fluxo WhatsApp OTP self-contained (criar/atualizar usuários via Admin API)
SUPABASE_URL=        # mesma URL do VITE_SUPABASE_URL, sem VITE_ (lido apenas no server)
SUPABASE_ANON_KEY=   # mesma key do VITE_SUPABASE_ANON_KEY (lido apenas no server)
SUPABASE_SERVICE_ROLE_KEY=  # chave service_role do projeto Supabase (Settings → API)

# Evolution API para envio de WhatsApp OTP
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# E-mail de acesso (link + senha temporária) — SMTP do cPanel da Revivaz.
# Só a senha é segredo (na VPS: Docker secret SMTP_PASS_FILE). Sem ela, em dev
# o e-mail sai no console do servidor.
# mail.revivaz.com.br aponta para a VPS; o SMTP é o servidor da HostMídia.
SMTP_HOST=r220us.hmservers.net
SMTP_PORT=465
SMTP_USER=contato@revivaz.com.br
SMTP_PASS=
