# Chave dedicada com TETO DE GASTO no console Anthropic. Nunca commitar a real.
ANTHROPIC_API_KEY=

# Supabase — público (usado no frontend via VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-side only (NUNCA expor no frontend)
# Necessário para o fluxo WhatsApp OTP self-contained (criar/atualizar usuários via Admin API)
SUPABASE_URL=        # mesma URL do VITE_SUPABASE_URL, sem VITE_ (lido apenas no server)
SUPABASE_ANON_KEY=   # mesma key do VITE_SUPABASE_ANON_KEY (lido apenas no server)
SUPABASE_SERVICE_ROLE_KEY=  # chave service_role do projeto Supabase (Settings → API)

# Evolution API para envio de WhatsApp OTP
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Gemini (IA de acolhimento)
GEMINI_API_KEY=
